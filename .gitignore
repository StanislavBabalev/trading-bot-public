bin/
obj/
*.user
.vs/

# Python virtual environment (Python 3.14 via the Python install manager)
.venv/
__pycache__/

# Downloaded market data: regenerate with `dotnet run --project src/Backtester.Cli -- fetch`
data/

# Bulky per-run outputs (equity curves, trades). Audit files and oos_access.log stay tracked.
artifacts/runs/
artifacts/optimizations/
artifacts/walkforward/
artifacts/bench/

# Experiment store: a cache of every backtest result, keyed by its full identity. The hunt log, trial registry and
# cycle reports stay the research record; deleting the store only means results get recomputed.
artifacts/cache/
# Live state of a research run (brief.md, diagnostics.json, model_calls.jsonl and proposals/ stay tracked)
artifacts/research/status.json
artifacts/research/run.lock
artifacts/research/STOP
*.tmp

# Validation bundles: the bulky CSV exports are regenerated by `python -m validation run`. Reports, metadata, stress and
# perturbation results, the trial index/analysis, the robustness registry and the summaries stay tracked.
artifacts/validation/**/*.csv
!artifacts/validation/trials/index.csv

# Generated index of local reports (links into the ignored folders above); rebuild with `report --all`
artifacts/index.html

# Kept locally, never published: personal project notes (email, local paths, account setup) and trader.dev's own
# market-coverage export and page (third-party material from the STEP 0 audit).
CLAUDE.md
artifacts/audit/market_coverage.html
artifacts/audit/market_coverage_data.json
