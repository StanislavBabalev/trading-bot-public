//@version=6
// EMA crossover with a direction switch and a fixed ATR stop-loss.
// tradeMode: 0 = long and short (reverses on opposite cross), 1 = long only (goes flat on bearish cross).
// Stop is fixed at entry: entry close -/+ ATR * atrMult. atrMult = 0 turns the stop off.
// No leverage (100% equity, margin 100). Nothing refused.
// Defaults = best settings from the 2026-10-26 optimization on trader.dev.
strategy("EMA Crossover + ATR Stop", overlay=true, pyramiding=1, process_orders_on_close=true, commission_type=strategy.commission.percent, commission_value=0.05, initial_capital=10000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, margin_long=100, margin_short=100)

fastLen = input.int(80, "Fast EMA", minval=1)
slowLen = input.int(260, "Slow EMA", minval=1)
tradeMode = input.int(1, "Mode (0 = long+short, 1 = long only)", minval=0, maxval=1)
atrLen = input.int(14, "ATR length", minval=1)
atrMult = input.float(5.0, "ATR stop multiple (0 = off)", minval=0, step=0.5)

fast = ta.ema(close, fastLen)
slow = ta.ema(close, slowLen)
atr = ta.atr(atrLen)

longEntry = ta.crossover(fast, slow)
shortEntry = ta.crossunder(fast, slow)
useStop = atrMult > 0

var float longStop = na
var float shortStop = na

if longEntry
    longStop := close - atr * atrMult
    strategy.entry("L", strategy.long)
if shortEntry
    if tradeMode == 0
        shortStop := close + atr * atrMult
        strategy.entry("S", strategy.short)
    else
        strategy.close("L")

if useStop and (longEntry or strategy.position_size > 0)
    strategy.exit("LX", from_entry="L", stop=longStop)
if useStop and tradeMode == 0 and (shortEntry or strategy.position_size < 0)
    strategy.exit("SX", from_entry="S", stop=shortStop)

plot(fast, title="EMA fast")
plot(slow, title="EMA slow")
plot(longEntry ? 1 : 0, title="longEntry")
plot(shortEntry ? 1 : 0, title="shortEntry")
